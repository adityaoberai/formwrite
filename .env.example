# Appwrite Cloud endpoint for the project's region
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=formwrite
# Local development only. On Appwrite Sites every SSR request carries a dynamic API key (the
# x-appwrite-key header) with the scopes configured on the site, so this variable is not set there.
# Required scopes, on this key or on the site: sessions.write, users.read, users.write, teams.read, teams.write,
# documentsdb.* (read, write, collections, documents, indexes), buckets.read, buckets.write, files.read, files.write
APPWRITE_API_KEY=
# Dedicated DocumentsDB database that holds every tenant's collections
APPWRITE_DATABASE_ID=formwrite
